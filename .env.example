# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://buildinstead.com

# --- Optional: Supabase (stores tool suggestions and contact messages) ---
# Without these, the Suggest and Contact forms fall back to opening the visitor's
# email app (mailto). Nothing is ever faked as "submitted".
# Run supabase/schema.sql in the Supabase SQL editor first.
# Server-only: do NOT prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
