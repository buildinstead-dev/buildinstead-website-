# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values. All variables below are server-only unless they
# start with NEXT_PUBLIC_.

# Public URL of the deployed site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://buildinstead.com

# --- Email delivery for the Contact and Suggest a Tool forms (Resend) ---
# API key from https://resend.com/api-keys (starts with re_). Server-only.
RESEND_API_KEY=
# Inbox that receives form submissions.
CONTACT_EMAIL=hello@buildinstead.com
# Sender address. Must be on a domain you have verified in Resend.
EMAIL_FROM=BuildInstead <hello@buildinstead.com>

# --- Optional: also archive submissions in Supabase ---
# Run supabase/schema.sql first. Leave empty to use email only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
